# =============================================================================
# ices0 Build Environment
# =============================================================================
FROM alpine:latest

ARG BOOTLIN_AARCH64_MUSL_URL="https://toolchains.bootlin.com/downloads/releases/toolchains/aarch64/tarballs/aarch64--musl--stable-2025.08-1.tar.xz"
ARG GLIBC_APK_VERSION="2.35-r1"
ARG PYTHON_VERSION="3.12.10"
ARG PYTHON_MINOR="3.12"
ARG PERL_VERSION="5.38.4"

# Install build tools and the static-friendly Alpine packages we can reuse.
RUN apk add --no-cache \
    autoconf automake bison build-base bzip2 bzip2-dev ca-certificates cmake \
    curl file git libogg-dev libogg-static libtool libvorbis-dev \
    libvorbis-static libxml2-dev libxml2-static linux-headers nasm openssl-dev \
    openssl-libs-static patch pkgconf python3 qemu-aarch64 readline-dev \
    samurai sqlite-dev tar wget xz xz-dev xz-static zlib-dev zlib-static \
    faad2-dev faad2-static flac-dev flac-static flex libffi-dev libffi-static \
    perl perl-dev

RUN mkdir -p /build && \
    wget -q -O /etc/apk/keys/sgerrand.rsa.pub https://alpine-pkgs.sgerrand.com/sgerrand.rsa.pub && \
    wget -q -O /build/glibc.apk "https://github.com/sgerrand/alpine-pkg-glibc/releases/download/${GLIBC_APK_VERSION}/glibc-${GLIBC_APK_VERSION}.apk" && \
    apk add --no-cache /build/glibc.apk && \
    ln -s /usr/glibc-compat/lib64 /lib64 && \
    rm -f /build/glibc.apk

RUN mkdir -p /opt/toolchains && \
    wget -q "${BOOTLIN_AARCH64_MUSL_URL}" -O /opt/toolchains/aarch64-musl.tar.xz && \
    tar -xJf /opt/toolchains/aarch64-musl.tar.xz -C /opt/toolchains && \
    rm -f /opt/toolchains/aarch64-musl.tar.xz && \
    ln -s /opt/toolchains/aarch64--musl--stable-2025.08-1 /opt/toolchains/aarch64-musl

# Build static-only dependencies that Alpine either does not package or does not
# package in a form that works for a fully static scratch-compatible target.
RUN wget -q "https://sourceforge.net/projects/lame/files/lame/3.100/lame-3.100.tar.gz/download" -O lame.tar.gz && \
    tar xzf lame.tar.gz && cd lame-*/ && \
    ./configure --prefix=/usr --disable-shared --enable-static --enable-nasm --disable-frontend && \
    make -j$(nproc) && make install && cd .. && rm -rf lame-*/ lame.tar.gz

RUN git clone --depth 1 https://github.com/enzo1982/mp4v2.git /build/mp4v2 && \
    cd /build/mp4v2 && \
    autoreconf -fi && \
    ./configure --prefix=/usr --disable-shared --enable-static --disable-util && \
    make -j$(nproc) && make install && \
    rm -rf /build/mp4v2

RUN git clone --depth 1 --recursive https://github.com/xiph/Icecast-libshout.git /build/libshout && \
    cd /build/libshout && \
    ./autogen.sh && \
    ./configure --prefix=/usr --disable-shared --enable-static \
      --disable-examples --disable-tools --disable-theora --disable-speex && \
    make -j$(nproc) && make install && \
    rm -rf /build/libshout

# Static Python for embedding in ices0 (amd64 host build; arm64 is cross-compiled at runtime)
RUN --mount=type=cache,target=/root/.cache/pip \
    wget -q "https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tar.xz" \
        -O /tmp/python.tar.xz && \
    tar -xJf /tmp/python.tar.xz -C /tmp && \
    cd /tmp/Python-${PYTHON_VERSION} && \
    ./configure \
        --prefix=/usr/local/python-static \
        --disable-shared \
        --without-ensurepip \
        --disable-test-modules \
        ac_cv_file__dev_ptmx=no \
        ac_cv_file__dev_ptc=no && \
    make -j$(nproc) && \
    make install && \
    rm -rf /tmp/Python-${PYTHON_VERSION} /tmp/python.tar.xz

# Static Perl for embedding in ices0 (amd64 host build; arm64 is cross-compiled at runtime)
RUN wget -q "https://www.cpan.org/src/5.0/perl-${PERL_VERSION}.tar.gz" \
        -O /tmp/perl.tar.gz && \
    tar -xzf /tmp/perl.tar.gz -C /tmp && \
    cd /tmp/perl-${PERL_VERSION} && \
    sh Configure -des \
        -Dprefix=/usr/local/perl-static \
        -Dcc=gcc \
        -Duseshrplib=false \
        -Dusedl=false \
        -Dstatic_ext='none' \
        -Dman1dir=none \
        -Dman3dir=none \
        -Doptimize='-Os' && \
    make -j$(nproc) && \
    make install && \
    rm -rf /tmp/perl-${PERL_VERSION} /tmp/perl.tar.gz

WORKDIR /build

# Build script
COPY <<'EOF' /usr/local/bin/build-ices0
#!/bin/sh
set -eu

ARCH="${1:-amd64}"
BUILD_ROOT=/build
SOURCE_ROOT="${BUILD_ROOT}/sources"
ARM64_TOOLCHAIN_ROOT=/opt/toolchains/aarch64-musl
ARM64_TRIPLE=aarch64-buildroot-linux-musl
ARM64_PREFIX=/opt/ices0-static/arm64

fetch_archive() {
    url="$1"
    archive_name="$2"
    dest_dir="$3"

    mkdir -p "${SOURCE_ROOT}"
    archive_path="${SOURCE_ROOT}/${archive_name}"
    rm -rf "${dest_dir}"
    mkdir -p "${dest_dir}"

    if [ ! -f "${archive_path}" ]; then
        curl -L --fail --retry 3 "${url}" -o "${archive_path}"
    fi

    case "${archive_name}" in
        *.tar.gz|*.tgz) tar -xzf "${archive_path}" -C "${dest_dir}" --strip-components=1 ;;
        *.tar.xz) PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" tar -xJf "${archive_path}" -C "${dest_dir}" --strip-components=1 ;;
        *) echo "Unsupported archive format: ${archive_name}" >&2; exit 1 ;;
    esac
}

fetch_git() {
    repo="$1"
    dest_dir="$2"
    shift 2
    rm -rf "${dest_dir}"
    git clone --depth 1 "$@" "${repo}" "${dest_dir}"
}

prepare_cross_pkg_config() {
    mkdir -p "${ARM64_PREFIX}/bin" "${ARM64_PREFIX}/share/pkgconfig"
    cat > "${ARM64_PREFIX}/bin/pkg-config" <<EOF2
#!/bin/sh
export PKG_CONFIG_LIBDIR="${ARM64_PREFIX}/lib/pkgconfig:${ARM64_PREFIX}/share/pkgconfig"
export PKG_CONFIG_PATH="${ARM64_PREFIX}/lib/pkgconfig:${ARM64_PREFIX}/share/pkgconfig"
exec /usr/bin/pkg-config "\$@"
EOF2
    chmod +x "${ARM64_PREFIX}/bin/pkg-config"
}

build_arm64_deps() {
    if [ -f "${ARM64_PREFIX}/.complete" ]; then
        return
    fi

    if [ ! -x "${ARM64_TOOLCHAIN_ROOT}/bin/${ARM64_TRIPLE}-gcc" ]; then
        echo "Missing Bootlin toolchain at ${ARM64_TOOLCHAIN_ROOT}" >&2
        exit 1
    fi

    export PATH="${ARM64_PREFIX}/bin:${ARM64_TOOLCHAIN_ROOT}/bin:${PATH}"
    export CC="${ARM64_TRIPLE}-gcc"
    export CXX="${ARM64_TRIPLE}-g++"
    export AR="${ARM64_TRIPLE}-ar"
    export RANLIB="${ARM64_TRIPLE}-ranlib"
    export STRIP="${ARM64_TRIPLE}-strip"
    export CFLAGS="-Os"
    export CXXFLAGS="${CFLAGS}"
    export CPPFLAGS="-I${ARM64_PREFIX}/include"
    export LDFLAGS="-static -L${ARM64_PREFIX}/lib"
    export PKG_CONFIG_LIBDIR="${ARM64_PREFIX}/lib/pkgconfig:${ARM64_PREFIX}/share/pkgconfig"
    export PKG_CONFIG_PATH="${PKG_CONFIG_LIBDIR}"

    mkdir -p "${ARM64_PREFIX}" "${SOURCE_ROOT}"
    prepare_cross_pkg_config

    fetch_archive "https://zlib.net/fossils/zlib-1.3.1.tar.gz" "zlib-1.3.1.tar.gz" "${SOURCE_ROOT}/zlib"
    (
        cd "${SOURCE_ROOT}/zlib"
        CHOST="${ARM64_TRIPLE}" ./configure --prefix="${ARM64_PREFIX}" --static
        make -j$(nproc)
        make install
    )

    fetch_archive "https://github.com/tukaani-project/xz/releases/download/v5.6.3/xz-5.6.3.tar.gz" "xz-5.6.3.tar.gz" "${SOURCE_ROOT}/xz"
    (
        cd "${SOURCE_ROOT}/xz"
        ./configure --host="${ARM64_TRIPLE}" --build="$(gcc -dumpmachine)" \
            --prefix="${ARM64_PREFIX}" --disable-shared --enable-static
        make -j$(nproc)
        make install
    )

    fetch_archive "https://github.com/openssl/openssl/releases/download/openssl-3.5.0/openssl-3.5.0.tar.gz" "openssl-3.5.0.tar.gz" "${SOURCE_ROOT}/openssl"
    (
        cd "${SOURCE_ROOT}/openssl"
        ./Configure linux-aarch64 no-shared no-tests -static \
            --prefix="${ARM64_PREFIX}" --openssldir="${ARM64_PREFIX}/ssl"
        make -j$(nproc)
        make install_sw
    )

    fetch_archive "https://download.gnome.org/sources/libxml2/2.12/libxml2-2.12.9.tar.xz" "libxml2-2.12.9.tar.xz" "${SOURCE_ROOT}/libxml2"
    (
        cd "${SOURCE_ROOT}/libxml2"
        ./configure --host="${ARM64_TRIPLE}" --build="$(gcc -dumpmachine)" \
            --prefix="${ARM64_PREFIX}" --disable-shared --enable-static \
            --without-python --with-zlib="${ARM64_PREFIX}" --with-lzma="${ARM64_PREFIX}" \
            --without-iconv
        make -j$(nproc)
        make install
    )

    fetch_archive "https://downloads.xiph.org/releases/ogg/libogg-1.3.5.tar.xz" "libogg-1.3.5.tar.xz" "${SOURCE_ROOT}/libogg"
    (
        cd "${SOURCE_ROOT}/libogg"
        ./configure --host="${ARM64_TRIPLE}" --build="$(gcc -dumpmachine)" \
            --prefix="${ARM64_PREFIX}" --disable-shared --enable-static
        make -j$(nproc)
        make install
    )

    fetch_archive "https://downloads.xiph.org/releases/vorbis/libvorbis-1.3.7.tar.gz" "libvorbis-1.3.7.tar.gz" "${SOURCE_ROOT}/libvorbis"
    (
        cd "${SOURCE_ROOT}/libvorbis"
        ./configure --host="${ARM64_TRIPLE}" --build="$(gcc -dumpmachine)" \
            --prefix="${ARM64_PREFIX}" --disable-shared --enable-static
        make -j$(nproc)
        make install
    )

    fetch_archive "https://github.com/knik0/faad2/archive/refs/tags/2_10_0.tar.gz" "faad2-2_10_0.tar.gz" "${SOURCE_ROOT}/faad2"
    (
        cd "${SOURCE_ROOT}/faad2"
        autoreconf -fi
        ./configure --host="${ARM64_TRIPLE}" --build="$(gcc -dumpmachine)" \
            --prefix="${ARM64_PREFIX}" --disable-shared --enable-static
        make -j$(nproc)
        make install
    )

    fetch_archive "https://github.com/xiph/flac/releases/download/1.4.3/flac-1.4.3.tar.xz" "flac-1.4.3.tar.xz" "${SOURCE_ROOT}/flac"
    (
        cd "${SOURCE_ROOT}/flac"
        ./configure --host="${ARM64_TRIPLE}" --build="$(gcc -dumpmachine)" \
            --prefix="${ARM64_PREFIX}" --disable-shared --enable-static \
            --disable-examples --disable-programs --disable-cpplibs
        make -j$(nproc)
        make install
    )

    fetch_archive "https://sourceforge.net/projects/lame/files/lame/3.100/lame-3.100.tar.gz/download" "lame-3.100.tar.gz" "${SOURCE_ROOT}/lame"
    (
        cd "${SOURCE_ROOT}/lame"
        ./configure --host="${ARM64_TRIPLE}" --build="$(gcc -dumpmachine)" \
            --prefix="${ARM64_PREFIX}" --disable-shared --enable-static \
            --disable-nasm --disable-frontend
        make -j$(nproc)
        make install
    )

    fetch_git "https://github.com/enzo1982/mp4v2.git" "${SOURCE_ROOT}/mp4v2"
    (
        cd "${SOURCE_ROOT}/mp4v2"
        autoreconf -fi
        ./configure --host="${ARM64_TRIPLE}" --build="$(gcc -dumpmachine)" \
            --prefix="${ARM64_PREFIX}" --disable-shared --enable-static --disable-util
        make -j$(nproc)
        make install
    )

    fetch_git "https://github.com/xiph/Icecast-libshout.git" "${SOURCE_ROOT}/libshout" --recursive
    (
        cd "${SOURCE_ROOT}/libshout"
        ./autogen.sh
        ./configure --host="${ARM64_TRIPLE}" --build="$(gcc -dumpmachine)" \
            --prefix="${ARM64_PREFIX}" --disable-shared --enable-static \
            --disable-examples --disable-tools --disable-theora --disable-speex
        make -j$(nproc)
        make install
    )

    fetch_archive "https://www.python.org/ftp/python/3.12.10/Python-3.12.10.tar.xz" "Python-3.12.10.tar.xz" "${SOURCE_ROOT}/python"
    (
        cd "${SOURCE_ROOT}/python"
        cat > config.cache <<CACHE
ac_cv_file__dev_ptmx=no
ac_cv_file__dev_ptc=no
ac_cv_buggy_getaddrinfo=no
ac_cv_have_long_long_format=yes
ac_cv_pthread_is_default=yes
ac_cv_working_tzset=yes
CACHE
        ./configure \
            --host="${ARM64_TRIPLE}" \
            --build="$(gcc -dumpmachine)" \
            --prefix="${ARM64_PREFIX}" \
            --disable-shared \
            --without-ensurepip \
            --disable-test-modules \
            --with-build-python=/usr/local/python-static/bin/python3 \
            --cache-file=config.cache
        make -j$(nproc) libpython3.12.a
        make install
    )
    # python3-config from cross-built Python is an arm64 binary; replace with a
    # host-runnable wrapper that returns the correct arm64 compile/link flags.
    cat > "${ARM64_PREFIX}/bin/python3-config" <<PYCONF
#!/bin/sh
PREFIX="${ARM64_PREFIX}"
PYVER=3.12
case "\$1" in
    --includes|--cflags) printf '%s\n' "-I\${PREFIX}/include/python\${PYVER}" ;;
    --ldflags|--embed) printf '%s\n' "-L\${PREFIX}/lib -lpython\${PYVER}" ;;
    --prefix|--exec-prefix) printf '%s\n' "\${PREFIX}" ;;
    --extension-suffix) printf '%s\n' ".cpython-312-aarch64-linux-musl.so" ;;
esac
PYCONF
    chmod +x "${ARM64_PREFIX}/bin/python3-config"
    ln -sf python3-config "${ARM64_PREFIX}/bin/python3.12-config"

    fetch_archive "https://www.cpan.org/src/5.0/perl-5.38.4.tar.gz" "perl-5.38.4.tar.gz" "${SOURCE_ROOT}/perl"
    (
        cd "${SOURCE_ROOT}/perl"
        sh Configure -des \
            -Dprefix="${ARM64_PREFIX}" \
            -Dcc="${CC}" \
            -Dar="${AR}" \
            -Dranlib="${RANLIB}" \
            -Duseshrplib=false \
            -Dusedl=false \
            -Dstatic_ext='none' \
            -Dman1dir=none \
            -Dman3dir=none \
            -Doptimize='-Os' \
            -Dhostperl=/usr/local/perl-static/bin/perl
        make -j$(nproc)
        make install
    )
    # Create a perl wrapper that returns arm64 embed flags without executing the
    # arm64 perl binary on the host.
    _PERL_ARCH=$(ls "${ARM64_PREFIX}/lib/perl5/" | grep '^5\.' | head -1)
    _PERL_CORE="${ARM64_PREFIX}/lib/perl5/${_PERL_ARCH}/aarch64-linux/CORE"
    cat > "${ARM64_PREFIX}/bin/perl-embed-wrap" <<PERLCONF
#!/bin/sh
case "\$*" in
    *ccopts*) printf '%s\n' "-I${_PERL_CORE}" ;;
    *ldopts*) printf '%s\n' "-L${_PERL_CORE} -lperl -lm -ldl -pthread" ;;
    *)        exec /usr/local/perl-static/bin/perl "\$@" ;;
esac
PERLCONF
    chmod +x "${ARM64_PREFIX}/bin/perl-embed-wrap"
    ln -sf perl-embed-wrap "${ARM64_PREFIX}/bin/perl"

    touch "${ARM64_PREFIX}/.complete"
}

case "$ARCH" in
    amd64)
        PREFIX=/usr
        CC=gcc; CXX=g++; STRIP=strip; HOST=""
        export PATH="/usr/local/python-static/bin:/usr/local/perl-static/bin:${PATH}"
        CFLAGS="-std=gnu17 -Os -I${PREFIX}/include"
        CPPFLAGS="-I${PREFIX}/include -DWAIT_ANY=-1 -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types"
        LDFLAGS="-static -L${PREFIX}/lib"
        PKG_CONFIG_LIBDIR="${PREFIX}/lib/pkgconfig"
        PKG_CONFIG_PATH="${PKG_CONFIG_LIBDIR}"
        XML2_CONFIG="${PREFIX}/bin/xml2-config"
        ;;
    arm64)
        PREFIX="${ARM64_PREFIX}"
        build_arm64_deps
        export PATH="${PREFIX}/bin:${ARM64_TOOLCHAIN_ROOT}/bin:${PATH}"
        # python3-config and perl wrappers installed by build_arm64_deps are in PREFIX/bin
        CC="${ARM64_TRIPLE}-gcc"
        CXX="${ARM64_TRIPLE}-g++"
        STRIP="${ARM64_TRIPLE}-strip"
        HOST="--host=${ARM64_TRIPLE} --build=$(gcc -dumpmachine)"
        CFLAGS="-std=gnu17 -Os -I${PREFIX}/include"
        CPPFLAGS="-I${PREFIX}/include -DWAIT_ANY=-1 -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types"
        LDFLAGS="-static -L${PREFIX}/lib"
        PKG_CONFIG_LIBDIR="${PREFIX}/lib/pkgconfig:${PREFIX}/share/pkgconfig"
        PKG_CONFIG_PATH="${PKG_CONFIG_LIBDIR}"
        XML2_CONFIG="${PREFIX}/bin/xml2-config"
        ;;
    *) echo "Supported architectures: amd64 arm64"; exit 1 ;;
esac

echo "Building ices0 for ${ARCH}..."
cd /build
rm -rf ices0
git clone https://github.com/Moonbase59/ices0.git && cd ices0

VERSION=$(sed -n 's/.*m4_define(ICES_MAJOR, \([0-9]*\)).*/\1/p' configure.ac).$(sed -n 's/.*m4_define(ICES_MINOR, \([0-9]*\)).*/\1/p' configure.ac).$(sed -n 's/.*m4_define(ICES_MICRO, \([0-9]*\)).*/\1/p' configure.ac)

export CC CXX CFLAGS CPPFLAGS LDFLAGS PKG_CONFIG_PATH PKG_CONFIG_LIBDIR
LIBSTDCPP=$(${CXX} -print-file-name=libstdc++.a)
LIBSUPCPP=$(${CXX} -print-file-name=libsupc++.a)
LIBGCC=$(${CC} -print-libgcc-file-name)
export LIBS="-lshout ${PREFIX}/lib/libmp4v2.a ${LIBSTDCPP} ${LIBSUPCPP} ${LIBGCC} -lfaad -lvorbisfile -lvorbis -logg -lFLAC -lmp3lame -lxml2 -llzma -lssl -lcrypto -lz -lm -ldl -pthread"

autoreconf -fi
./configure ${HOST} --prefix=/usr \
  --with-lame="${PREFIX}" --with-vorbis="${PREFIX}" --with-faad="${PREFIX}" --with-flac="${PREFIX}" \
  --with-xml-config="${XML2_CONFIG}"

if ! make -j$(nproc); then
  # libtool reorders the static C++ runtime ahead of libmp4v2.a, so do the
  # final link manually after the objects have been built.
  _PYVER=3.12
  _PYLIB=$(ls "${PREFIX}/lib/libpython${_PYVER}.a" 2>/dev/null || true)
  _PERL_ARCH=$(ls "${PREFIX}/lib/perl5/" 2>/dev/null | grep '^5\.' | head -1)
  _PERL_TRIPLE=$(ls "${PREFIX}/lib/perl5/${_PERL_ARCH}/" 2>/dev/null | grep -v '^[A-Z]' | head -1)
  _PERLLIB="${PREFIX}/lib/perl5/${_PERL_ARCH}/${_PERL_TRIPLE}/CORE/libperl.a"
  cd src
  ${CC} -std=gnu17 -Os -Wall -I"${PREFIX}/include" \
    -static -L"${PREFIX}/lib" \
    -o ices \
    ices.o log.o setup.o stream.o util.o mp3.o cue.o metadata.o id3.o \
    signals.o crossfade.o replaygain.o ices_config.o reencode.o \
    in_vorbis.o in_mp4.o in_flac.o playlist/libplaylist.a \
    "${PREFIX}/lib/libshout.a" -lssl -lcrypto -lxml2 -lz -llzma \
    "${PREFIX}/lib/libmp3lame.a" -lvorbisfile -lvorbis -logg \
    "${PREFIX}/lib/libmp4v2.a" "${LIBSTDCPP}" "${LIBSUPCPP}" "${LIBGCC}" \
    ${_PYLIB:+"${_PYLIB}"} ${_PERLLIB:+"${_PERLLIB}"} \
    -lfaad -lFLAC -lm -ldl -pthread
  cd ..
fi
${STRIP} src/ices

mkdir -p /output
cp src/ices /output/ices0-linux-${ARCH}
echo "${VERSION}" > /output/VERSION
echo "Built: /output/ices0-linux-${ARCH} (v${VERSION})"
EOF

RUN chmod +x /usr/local/bin/build-ices0
WORKDIR /workspace
CMD ["echo", "Usage: build-ices0 [amd64|arm64]"]
