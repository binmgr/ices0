# =============================================================================
# ices0 Build Environment
# =============================================================================
FROM alpine:latest

# Install ALL build tools and static libraries
RUN apk add --no-cache \
    build-base curl wget git autoconf automake libtool pkgconf nasm \
    linux-headers tar xz bzip2 ca-certificates perl python3 \
    # Static libraries (native amd64)
    zlib-static openssl-libs-static libxml2-static \
    libogg-static libvorbis-static flac-static faad2-static libshout-static \
    # Dev headers
    zlib-dev openssl-dev libxml2-dev \
    libogg-dev libvorbis-dev flac-dev faad2-dev libshout-dev lame-dev

# Build lame static (not available in Alpine)
RUN wget -q "https://sourceforge.net/projects/lame/files/lame/3.100/lame-3.100.tar.gz/download" -O lame.tar.gz && \
    tar xzf lame.tar.gz && cd lame-*/ && \
    ./configure --prefix=/usr --disable-shared --enable-static --enable-nasm --disable-frontend && \
    make -j$(nproc) && make install && cd .. && rm -rf lame-*/ lame.tar.gz

WORKDIR /build

# Build script
COPY <<'EOF' /usr/local/bin/build-ices0
#!/bin/sh
set -e
ARCH="${1:-amd64}"

case "$ARCH" in
    amd64)
        CC=gcc; STRIP=strip; HOST=""
        CFLAGS="-Os -I/usr/include"; LDFLAGS="-L/usr/lib"
        PKG_CONFIG_PATH="/usr/lib/pkgconfig"
        ;;
    *) echo "Only amd64 supported for now"; exit 1 ;;
esac

echo "Building ices0 for ${ARCH}..."
cd /build
git clone https://github.com/Moonbase59/ices0.git && cd ices0

VERSION=$(grep -oE 'ICES_MAJOR=[0-9]+' configure.ac | cut -d= -f2 || echo "0").$(grep -oE 'ICES_MINOR=[0-9]+' configure.ac | cut -d= -f2 || echo "0").$(grep -oE 'ICES_MICRO=[0-9]+' configure.ac | cut -d= -f2 || echo "0")

export CC CFLAGS LDFLAGS PKG_CONFIG_PATH
export LIBS="-lshout -lvorbisfile -lvorbis -logg -lFLAC -lmp3lame -lfaad -lxml2 -lssl -lcrypto -lz -lm"

autoreconf -fi
./configure ${HOST} --prefix=/usr --without-python --without-perl

make -j$(nproc)
${STRIP} src/ices

mkdir -p /output
cp src/ices /output/ices0-linux-${ARCH}
echo "${VERSION}" > /output/VERSION
echo "Built: /output/ices0-linux-${ARCH} (v${VERSION})"
EOF

RUN chmod +x /usr/local/bin/build-ices0
WORKDIR /workspace
CMD ["echo", "Usage: build-ices0 [amd64]"]
